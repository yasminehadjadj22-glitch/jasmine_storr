# Supabase Configuration
# احصل على هذه القيم من Supabase Dashboard
# Get these values from Supabase Dashboard

# Supabase Project URL
VITE_SUPABASE_URL=your_supabase_url_here

# Supabase Anonymous Key (Public Key)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ملاحظات مهمة / Important Notes:
# 1. لا تشارك هذا الملف مع أحد / Don't share this file with anyone
# 2. لا ترفع هذا الملف على GitHub / Don't upload this file to GitHub
# 3. في Vercel، أضف هذه المتغيرات في Environment Variables
#    In Vercel, add these variables in Environment Variables
# 4. احصل على القيم من Supabase Dashboard:
#    Get values from Supabase Dashboard:
#    https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api
